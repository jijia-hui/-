# 复制为 .env 后按需修改；全部留空也可启动（使用 docker-compose.yml 中的默认值）
# 前端对外访问端口
WEB_PORT=8080

# 数据库密码（生产环境务必修改为强密码）
DB_PASSWORD=teach_pass_2026
DB_ROOT_PASSWORD=root_pass_2026

# Django 密钥（生产环境务必设置为随机长字符串；
# 留空时使用 settings.py 中的开发默认密钥，仅适合本地体验）
DJANGO_SECRET_KEY=

# 邮件配置（QQ 邮箱需授权码；不配置时邮件打印到后端控制台）
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
