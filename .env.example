# 复制为 .env 后按需修改；全部留空也可启动（使用 docker-compose.yml 中的默认值）
# 前端对外访问端口
WEB_PORT=8080
TZ=Asia/Shanghai

# 数据库密码（生产环境务必修改为强密码）
DB_PASSWORD=teach_pass_2026
DB_ROOT_PASSWORD=root_pass_2026

# Django 密钥（生产环境务必设置为随机长字符串；
# 留空时使用 settings.py 中的开发默认密钥，仅适合本地体验）
DJANGO_SECRET_KEY=

# 经 Nginx 访问 Django 后台 /admin/ 时的可信来源（与浏览器地址栏一致）
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 后端进程数（笔记本建议 2）
GUNICORN_WORKERS=2

# 邮件配置（QQ/126 邮箱填授权码；不配置时验证码打印到后端日志）
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=True

# ---- 微服务版（docker-compose.micro*.yml）----
# JWT 签发/验签共享密钥（生产环境务必设置为随机长字符串，>=32 字节）
JWT_SECRET=
# 服务间内部接口密钥（X-Internal-Key，生产环境务必修改）
INTERNAL_API_KEY=
# 镜像版本号（拉取式编排 docker-compose.micro.prod.yml 使用；默认 latest）
MICRO_IMAGE_TAG=latest
# 网关调试端口（宿主机直连网关用；0 或留空时由默认 8000 生效）
GATEWAY_PORT=8000
# 各服务健康检查返回的应用版本号（源码构建模式下的展示值）
APP_VERSION=dev-compose
